---
layout: none
search: exclude
---

[
{% for page in site.pages %}{% unless page.search == "exclude" %}{% if page.title %}
{
"title": "{{ page.title | escape }}",
"tags": "{{ page.tags }}",
"keywords": "{{page.keywords}}",
"url": "{{ page.url | prepend: site.baseurl }}",
"summary": "{{page.summary | strip }}"
},
{% endif %}{% endunless %}{% endfor %}
{% for collection in site.collections %}{% unless forloop.first %}{% assign collection_size = collection.docs | size %}{% if collection_size > 0 %},{% endif %}{% endunless %}
{% for post in collection.docs %}
{
"title": "{{ post.title | escape }}",
"tags": "{{ post.tags }}",
"keywords": "{{post.keywords}}",
"url": "{{ post.url | prepend: site.baseurl }}",
"summary": "{{post.summary | strip }}"
}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% endfor %}
]
